# Optional: only needed if you want the browser to call Gemini directly.
VITE_GEMINI_API_KEY=

# Required for protected UI actions.
VITE_DEV_MODE_PASSWORD=change-this-password
VITE_NODE_VAULT_PASSWORD=change-this-password

# Set this to your Render backend URL after the backend is deployed.
VITE_BACKEND_URL=https://your-render-backend.onrender.com

# 0 disables the frontend fetch timeout.
VITE_EXECUTE_TIMEOUT_MS=0
